# All keys are server-only. Never expose any of them as NEXT_PUBLIC_*.
# The one exception is NEXT_PUBLIC_SENTRY_DSN below: a DSN only lets a client
# submit events, so it is designed to be public.

# Postgres (required). All data except audio lives here; no fallback store.
DATABASE_URL=postgres://localhost:5432/mada

# Claude — report drafting, assessment/impression suggestion, exercise search.
ANTHROPIC_API_KEY=

# Transcription provider: openai | groq | local | auto (default: first available).
MADA_STT=auto
# Hosted options (either one). OpenAI gpt-4o-transcribe is the recommended pilot choice.
OPENAI_API_KEY=
GROQ_API_KEY=
# MADA_STT_MODEL=gpt-4o-transcribe

# Local whisper.cpp provider (defaults shown; see README to build it).
# WHISPER_SERVER=./vendor/whisper-cpp/whisper-server
# WHISPER_MODEL=./vendor/whisper-cpp/models/ggml-large-v3-turbo-q5_0.bin
# WHISPER_PORT=18317
# FFMPEG_PATH=ffmpeg

# Optional overrides
# MADA_CLAUDE_MODEL=claude-opus-5
# MADA_DATA_DIR=./data       # recordings only

# Sentry error tracking (errors only; nothing is sent when the DSN is empty).
SENTRY_DSN=
# Same DSN for the browser. Inlined at build time, so it must be set for `next build`.
NEXT_PUBLIC_SENTRY_DSN=
# Source-map upload at build time; skipped when the token is empty.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Enables the deliberate-throw routes for verify/sentry.mjs. Remove afterwards.
# SENTRY_DEBUG_ROUTE=1
