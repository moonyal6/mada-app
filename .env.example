# All keys are server-only. Never expose any of them as NEXT_PUBLIC_*.

# Claude — report drafting, assessment/impression suggestion, exercise search.
ANTHROPIC_API_KEY=

# Transcription provider: openai | groq | local | auto (default: first available).
MADA_STT=auto
# Hosted options (either one). OpenAI gpt-4o-transcribe is the recommended pilot choice.
OPENAI_API_KEY=
GROQ_API_KEY=
# MADA_STT_MODEL=gpt-4o-transcribe

# Local whisper.cpp provider (defaults shown; see README to build it).
# WHISPER_SERVER=./vendor/whisper-cpp/whisper-server
# WHISPER_MODEL=./vendor/whisper-cpp/models/ggml-large-v3-turbo-q5_0.bin
# WHISPER_PORT=18317
# FFMPEG_PATH=ffmpeg

# Optional overrides
# MADA_CLAUDE_MODEL=claude-opus-5
# MADA_DATA_DIR=./data
